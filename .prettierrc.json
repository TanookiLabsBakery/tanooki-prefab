{
  "$schema": "http://json.schemastore.org/prettierrc",
  "plugins": ["prettier-plugin-tailwindcss", "@trivago/prettier-plugin-sort-imports"],
  "printWidth": 100,
  "quoteProps": "consistent",
  "semi": false,
  "trailingComma": "es5",
  "importOrder": ["<THIRD_PARTY_MODULES>", "~/", "^[../]", "^[./]"],
  "importOrderSideEffects": false
}
