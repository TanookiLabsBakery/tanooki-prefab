    "vite-plugin-svgr": "^4.5.0"
  },
  "engines": {
    "node": "22.x"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix --max-warnings=0",
    "*.{js,ts,tsx,css,md}": "prettier --write",
    "{spec/**/*.rb,app/**/*.rb,config/**/*.rb}": "bundle exec standardrb --fix"
  },
  "packageManager": "pnpm@10.18.3",
  "private": true,
  "scripts": {
    "build": "pnpm run codegen-graphql",
    "codegen-graphql": "graphql-codegen --config codegen.ts",
    "codegen-graphql-watch": "pnpm run codegen-graphql --watch",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint --fix app/frontend",
    "lint-check": "eslint --max-warnings=0 app/frontend",
    "lint-files": "ls-lint",
    "prepare": "husky && (pnpm run codegen-graphql 2>/dev/null || true)",
    "schema-dump": "bin/rails graphql:schemas:dump",
    "schema-dump-watch": "chokidar \"app/graphql/**/*.rb\" -c \"bin/rails graphql:schemas:dump\"",
    "type-check": "tsc --noEmit"
  },
  "type": "module"
}
