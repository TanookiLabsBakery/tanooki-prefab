    "react-hook-form": "^7.52.2",
    "react-router-dom": "^6.26.1",
    "static-path": "^0.0.4",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "tiny-invariant": "^1.3.3",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@graphql-codegen/cli": "^5.0.2",
    "@ls-lint/ls-lint": "^2.2.3",
    "@parcel/watcher": "^2.4.1",
    "@tsconfig/vite-react": "^3.0.2",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^22.5.0",
    "@types/rails__actioncable": "^6.1.11",
    "@types/rails__activestorage": "^7.1.1",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "graphql-ruby-client": "^1.14.0",
    "husky": "^9.1.5",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.2.0",
    "vite": "^5.4.2",
    "vite-plugin-graphql-codegen": "^3.3.8",
    "vite-plugin-ruby": "^5.1.1",
    "vite-plugin-svgr": "^4.5.0"
  },
  "engines": {
    "node": "22.x"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix --max-warnings=0",
    "*.{js,ts,tsx,css,md}": "prettier --write",
    "{spec/**/*.rb,app/**/*.rb,config/**/*.rb}": "bundle exec standardrb --fix"
  },
  "packageManager": "pnpm@10.1.0+sha512.c89847b0667ddab50396bbbd008a2a43cf3b581efd59cf5d9aa8923ea1fb4b8106c041d540d08acb095037594d73ebc51e1ec89ee40c88b30b8a66c0fae0ac1b",
  "private": true,
  "scripts": {
    "build": "pnpm run codegen-graphql",
    "codegen-graphql": "graphql-codegen --config codegen.ts",
    "codegen-graphql-watch": "pnpm run codegen-graphql --watch",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint --fix app/frontend",
    "lint-check": "eslint --max-warnings=0 app/frontend",
    "lint-files": "ls-lint",
    "prepare": "husky",
    "schema-dump": "bin/rails graphql:schema:idl",
    "schema-dump-watch": "chokidar \"app/graphql/**/*.rb\" -c \"bin/rails graphql:schema:idl\"",
    "type-check": "tsc --noEmit"
  },
  "type": "module"
}
