<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Tanooki Prefab" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <% content_for :head %>
    <%= tag.meta name: "APP_NAME", content: AppConstants::APP_NAME %>
    <%= tag.meta name: "direct-uploads-url", content: Rails.application.routes.url_helpers.rails_direct_uploads_url(host: AppOrigin.url) %>

    <%= vite_react_refresh_tag %>
    <%= vite_stylesheet_tag "application" %>
    <%= vite_client_tag %>
    <%= vite_typescript_tag 'application.tsx' %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
