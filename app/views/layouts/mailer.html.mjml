<mjml>
  <mj-head>
    <mj-attributes>
      <mj-text font-family="Arial, sans-serif" font-size="14px" color="#000000" />
      <mj-button
        background-color="#333333"
        color="#FFFFFF"
        font-family="Arial, sans-serif"
        padding="10px 25px"
      />
      <mj-section padding="20px 0" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#ffffff">
    <!-- Body Section -->
    <%= yield %>

    <!-- Footer Section -->
    <mj-section background-color="#ffffff" padding="20px">
      <mj-column>
        <mj-text align="left" font-size="12px" color="#999999">
          Add
          <a href="mailto:membership@company.com">membership@company.com</a> to your address book to
          receive all Prefab emails. In eu maximus tellus, ut consectetur elit. Pellentesque sodales
          arcu ut elementum volutpat. Sed at laoreet libero. Class aptent taciti sociosqu ad litora
          torquent per conubia nostra, per inceptos himenaeos.
        </mj-text>
        <mj-text align="center" font-size="12px" color="#999999">
          <a href="https://www.example.com/unsubscribe">Unsubscribe</a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
