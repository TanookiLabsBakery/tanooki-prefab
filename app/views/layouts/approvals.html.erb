<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post Approval</title>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: Arial, sans-serif;
        font-size: 14px;
        color: #333;
        background-color: #f9f9f9;
        min-height: 100vh;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 40px 20px;
      }
      .container {
        background: #fff;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 32px;
        max-width: 680px;
        width: 100%;
      }
      h1 { font-size: 22px; font-weight: bold; margin-bottom: 8px; }
      h2 { font-size: 16px; font-weight: bold; margin: 20px 0 8px; }
      p { line-height: 1.6; margin: 8px 0; color: #555; }
      .variant {
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        padding: 14px 16px;
        margin: 8px 0;
        background: #fafafa;
      }
      .variant-channel {
        font-weight: bold;
        font-size: 12px;
        text-transform: uppercase;
        color: #888;
        margin-bottom: 6px;
      }
      .variant-body { color: #333; line-height: 1.6; white-space: pre-wrap; }
      .actions {
        display: flex;
        gap: 12px;
        margin-top: 28px;
        flex-wrap: wrap;
      }
      button {
        padding: 10px 24px;
        font-size: 14px;
        font-family: Arial, sans-serif;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: bold;
      }
      .btn-approve { background-color: #1a7f37; color: #fff; }
      .btn-approve:hover { background-color: #15652c; }
      .btn-reject { background-color: #cf222e; color: #fff; }
      .btn-reject:hover { background-color: #a11620; }
      .divider { border: none; border-top: 1px solid #e0e0e0; margin: 24px 0; }
      .label { font-size: 12px; color: #888; margin-bottom: 4px; }
    </style>
  </head>
  <body>
    <div class="container">
      <%= yield %>
    </div>
  </body>
</html>
